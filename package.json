{
  "name": "montecarlo",
  "version": "0.1.0",
  "description": "Monte Carlo simulation for TypeScript: describe what you're unsure about, get the odds.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "node scripts/demo.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "monte-carlo",
    "simulation",
    "probability",
    "estimation",
    "uncertainty",
    "statistics",
    "typescript"
  ],
  "author": "Michelle Vava",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
